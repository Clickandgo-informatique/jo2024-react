{% extends 'base.html.twig' %}
{% block title %}
	Liste des utilisateurs
{% endblock %}
{% block body %}
	<h1 class="text-center">Liste des utilisateurs</h1>
	{% if utilisateurs %}

		<table>
			<thead>
				<tr>
					<th></th>
					<th></th>
					<th scope="col">Pseudo</th>
					<th scope="col">Email</th>
					<th scope="col">Vérifié</th>
					<th scope="col">Rôles</th>
				</tr>
			</thead>

			<tbody>
				{% for u in utilisateurs %}
					<tr>
						<td>
							<a href="{{path('App_utilisateurs_edit',{id:u.id})}}">Editer</a>
						</td>
						<td>
							<a href="#">Supprimer</a>
						</td>
						<td>{{u.nickname}}</td>
						<td>{{u.email}}</td>
						<td>{{u.email}}</td>
						<td>{{u.roles}}</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p class="text-center">Il n'existe encore aucun utilisateur enregistré dans la base de données</p>
	{% endif %}
{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{asset('assets/css/table.css')}}">
{% endblock %}
