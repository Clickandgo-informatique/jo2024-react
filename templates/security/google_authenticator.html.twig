{% extends 'base.html.twig' %}
{% block body %}
	<h1 class="text-center">Google Authenticator</h1>
	<div id="qrcode">
		<p>Code actuel :
			{{ currentOtp }}</p>
		<div id="qrCode">
			<img src="data:image/png;base64,{{ qrCode }}" alt="QR Code">
		</div>
	</div>
	<h2 class="text-center">Vérification du code</h2>
	<form method="post">
		{{ form_start(form) }}
		{{ form_row(form.code) }}
		<button class="btn btn-primary" type="submit">Vérifier le code</button>
		{{ form_end(form) }}
	</form>
{% endblock %}
