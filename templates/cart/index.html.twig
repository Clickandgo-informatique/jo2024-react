{% extends 'base.html.twig' %}
{% block title %}
	<i class="fa-solid fa-cart-shopping"></i>Mon panier
{% endblock %}
{% block body %}
	<main>
		<a href="{{path('app_offres_catalogue')}}" class="btn btn-primary">
			<i class="fa-solid fa-list"></i>Revenir à la liste d'offres</a>
		<h1 class="text-center">
			<i class="fa-solid fa-cart-shopping"></i>Mon panier</h1>

		{# Tableau contenant le panier et tout ses items depuis requête Ajax #}
		<div class="cart-container">
			{{include('_partials/_cart-items.html.twig')}}
			{#Contenu Requête Ajax#}
		</div>

	</main>
{% endblock %}
{% block stylesheets %}
	<link rel="stylesheet" href="{{asset('assets/css/table.css')}}">
{% endblock %}
{% block javascripts %}
	<script type="module" src="{{asset('assets/js/cart.js')}}"></script>
{% endblock %}
